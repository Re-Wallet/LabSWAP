PUBLIC_DESTINO=RELLENA_CON_TU_CLAVE_PUBLICA_DESTINO

# Activo USDC Testnet (emisor de referencia)
USDC_EMISOR=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
USDC_CODIGO=USDC

# Soroswap SDK (Lab 2 — Opción A)
SOROSWAP_CLAVE=RELLENA_CON_TU_CLAVE_API_SOROSWAP
SOROSWAP_RED=TESTNET
